# Personal API key: https://www.nexusmods.com/users/myaccount?tab=api%20access
NEXUS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: OAuth Bearer token for the v2 GraphQL API
# NEXUS_OAUTH_TOKEN=

# Game domain used when the agent does not pass game_domain_name
NEXUS_DEFAULT_GAME=mountandblade2bannerlord

# Nexus requires an identifiable User-Agent
NEXUS_USER_AGENT=nexus-mods-mcp/0.3.0 (Windows; x64) Node/25

# Allow write operations (endorse, track, untrack, changelogs, rename). Disabled by default.
NEXUS_ALLOW_WRITES=false

# --- Publishing (v3 Upload API) ---
# Allow uploading archives and publishing them on a mod page.
# Requires NEXUS_ALLOW_WRITES=true as well.
NEXUS_ALLOW_UPLOADS=false

# Optional sandbox: archives outside this directory are refused
# NEXUS_UPLOAD_ROOT=C:\MyMods\NexusUploads

# Timeout for each presigned transfer, in seconds (default 900)
NEXUS_UPLOAD_TIMEOUT_SECONDS=900

# --- Tuning (optional) ---
# Read cache lifetime in seconds; 0 disables caching (default 300)
NEXUS_CACHE_TTL_SECONDS=300

# Per-request timeout in seconds (default 20)
NEXUS_TIMEOUT_SECONDS=20

# Retries on network errors / 5xx responses (default 2)
NEXUS_MAX_RETRIES=2
